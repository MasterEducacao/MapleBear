<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELA Y5 · Recuperação · MapleBear</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --blue-50: #eff6ff;
    --blue-100: #dbeafe;
    --blue-200: #bfdbfe;
    --blue-300: #93c5fd;
    --blue-400: #60a5fa;
    --blue-500: #3b82f6;
    --blue-600: #2563eb;
    --blue-700: #1d4ed8;
    --white: #ffffff;
    --glass-bg: rgba(255,255,255,0.68);
    --glass-border: rgba(59,130,246,0.18);
    --shadow-soft: 0 8px 32px rgba(59,130,246,0.10);
    --shadow-card: 0 4px 24px rgba(59,130,246,0.13);
    --radius-xl: 2rem;
    --radius-lg: 1.25rem;
    --radius-md: 0.875rem;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Nunito', sans-serif;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 40%, #e0f2fe 70%, #f0f9ff 100%);
    min-height: 100vh;
    color: #1e3a5f;
  }
  body::before {
    content:''; position: fixed; top: -120px; right: -120px;
    width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(96,165,250,0.18) 0%, transparent 70%);
    border-radius: 50%; pointer-events: none; z-index: 0;
  }
  body::after {
    content:''; position: fixed; bottom: -100px; left: -100px;
    width: 440px; height: 440px;
    background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
    border-radius: 50%; pointer-events: none; z-index: 0;
  }

  /* HEADER */
  header {
    position: sticky; top: 0; z-index: 100;
    backdrop-filter: blur(18px) saturate(1.4);
    background: rgba(255,255,255,0.78);
    border-bottom: 1.5px solid rgba(59,130,246,0.15);
    box-shadow: 0 2px 18px rgba(59,130,246,0.08);
    padding: 0.7rem 2rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .logo { display: flex; align-items: center; gap: 0.7rem; }
  .logo-icon { width: 42px; height: 42px; background: linear-gradient(135deg, var(--blue-400), var(--blue-600)); border-radius: 12px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; box-shadow: 0 4px 12px rgba(37,99,235,0.25); }
  .logo-text { font-family: 'Baloo 2', cursive; font-weight:800; font-size:1.2rem; color: var(--blue-600); }
  .logo-sub { font-size:0.72rem; font-weight:600; color: var(--blue-400); letter-spacing:.04em; }
  .progress-bar-wrap { flex:1; max-width:320px; }
  .progress-label { font-size:0.7rem; font-weight:700; color:var(--blue-500); margin-bottom:4px; text-transform:uppercase; letter-spacing:.06em; }
  .progress-track { height:8px; background:rgba(147,197,253,0.35); border-radius:99px; overflow:hidden; }
  .progress-fill { height:100%; background: linear-gradient(90deg, var(--blue-400), var(--blue-600)); border-radius:99px; transition: width .6s cubic-bezier(.4,0,.2,1); width:0%; }
  .score-badge { background: linear-gradient(135deg, var(--blue-400), var(--blue-600)); color:#fff; font-weight:800; font-size:0.95rem; padding:.38rem .9rem; border-radius:99px; box-shadow: 0 3px 12px rgba(37,99,235,0.28); display:flex; align-items:center; gap:.4rem; }

  /* HERO */
  .hero { text-align:center; padding: 3.5rem 1.5rem 2rem; position:relative; z-index:1; }
  .hero-badge { display:inline-block; background: linear-gradient(90deg,#60a5fa22,#3b82f611); border:1.5px solid var(--blue-300); border-radius:99px; padding:.3rem 1rem; font-size:.78rem; font-weight:700; color:var(--blue-600); letter-spacing:.06em; text-transform:uppercase; margin-bottom:1.1rem; }
  .hero h1 { font-family:'Baloo 2',cursive; font-weight:800; font-size:clamp(2rem,5vw,3rem); color:var(--blue-700); line-height:1.15; margin-bottom:.6rem; }
  .hero p { font-size:1.05rem; color:#2563eb99; max-width:620px; margin:0 auto; font-weight:600; }
  .hero-meta { display:flex; justify-content:center; gap:1.5rem; margin-top:1.2rem; flex-wrap:wrap; }
  .meta-chip { background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:99px; padding:.28rem .85rem; font-size:.76rem; font-weight:700; color:var(--blue-600); backdrop-filter:blur(8px); }

  /* STUDY GUIDE */
  .study-guide { max-width:860px; margin:1.5rem auto; padding:0 1rem; position:relative; z-index:1; }
  .guide-card { background:var(--glass-bg); border:1.5px solid var(--glass-border); border-radius:var(--radius-xl); padding:1.6rem 2rem; backdrop-filter:blur(12px); box-shadow:var(--shadow-soft); }
  .guide-card h2 { font-family:'Baloo 2',cursive; font-weight:800; font-size:1.15rem; color:var(--blue-700); margin-bottom:1rem; display:flex; align-items:center; gap:.5rem; }
  .guide-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  @media(max-width:600px){ .guide-grid { grid-template-columns:1fr; } }
  .guide-item { background:rgba(219,234,254,0.5); border-radius:var(--radius-md); padding:.9rem 1rem; border-left:4px solid var(--blue-400); }
  .guide-item strong { display:block; font-size:.8rem; font-weight:800; color:var(--blue-600); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.3rem; }
  .guide-item span { font-size:.88rem; color:#1e3a5f; }

  /* UNIT DIVIDER */
  .unit-divider { max-width:860px; margin:2rem auto 0; padding:0 1rem; position:relative; z-index:1; }
  .unit-label { display:flex; align-items:center; gap:.8rem; background:linear-gradient(90deg,rgba(37,99,235,0.10),transparent); border-left:4px solid var(--blue-600); border-radius:0 var(--radius-md) var(--radius-md) 0; padding:.6rem 1.2rem; margin-bottom:.3rem; }
  .unit-label span { font-family:'Baloo 2',cursive; font-weight:800; font-size:1.05rem; color:var(--blue-700); }
  .unit-label small { font-size:.75rem; font-weight:700; color:var(--blue-400); }

  /* SECTION NAV */
  .section-nav { display:flex; justify-content:center; gap:.7rem; padding:1rem 0 .5rem; position:relative; z-index:1; flex-wrap:wrap; }
  .nav-dot { background:var(--glass-bg); border:1.5px solid var(--glass-border); border-radius:99px; padding:.35rem .9rem; font-size:.75rem; font-weight:700; color:var(--blue-600); cursor:pointer; transition:all .2s; backdrop-filter:blur(8px); text-decoration:none; }
  .nav-dot:hover, .nav-dot.active { background:var(--blue-500); color:#fff; border-color:var(--blue-500); }

  /* CARDS */
  .cards-grid { max-width:860px; margin:0 auto; padding:1rem; display:grid; gap:1.4rem; position:relative; z-index:1; }
  .card { background:var(--glass-bg); border:1.5px solid var(--glass-border); border-radius:var(--radius-xl); padding:1.8rem 2rem; backdrop-filter:blur(12px); box-shadow:var(--shadow-card); }
  .card-header { display:flex; align-items:flex-start; gap:1rem; margin-bottom:1.2rem; }
  .card-icon { width:52px; height:52px; min-width:52px; border-radius:var(--radius-md); display:flex; align-items:center; justify-content:center; font-size:1.6rem; box-shadow:0 4px 12px rgba(37,99,235,0.18); }
  .card-icon.purple { background:linear-gradient(135deg,#a78bfa,#7c3aed); }
  .card-icon.green  { background:linear-gradient(135deg,#34d399,#059669); }
  .card-icon.blue   { background:linear-gradient(135deg,#60a5fa,#2563eb); }
  .card-icon.orange { background:linear-gradient(135deg,#fb923c,#ea580c); }
  .card-icon.pink   { background:linear-gradient(135deg,#f472b6,#db2777); }
  .card-icon.teal   { background:linear-gradient(135deg,#2dd4bf,#0d9488); }
  .card-icon.indigo { background:linear-gradient(135deg,#818cf8,#4f46e5); }
  .card-icon.yellow { background:linear-gradient(135deg,#fbbf24,#d97706); }
  .card-icon.red    { background:linear-gradient(135deg,#f87171,#dc2626); }
  .card-icon.emerald{ background:linear-gradient(135deg,#6ee7b7,#10b981); }
  .card-title { font-family:'Baloo 2',cursive; font-weight:800; font-size:1.2rem; color:var(--blue-700); }
  .card-sub { font-size:.8rem; font-weight:700; color:var(--blue-400); margin-top:.1rem; }

  /* DEFINITION BOX */
  .def-box { background:linear-gradient(135deg,#eff6ff,#dbeafe); border:1.5px solid #bfdbfe; border-radius:var(--radius-lg); padding:1rem 1.2rem; margin-bottom:1rem; }
  .def-box .label { font-size:.72rem; font-weight:800; color:var(--blue-600); text-transform:uppercase; letter-spacing:.06em; margin-bottom:.3rem; }
  .def-box p { font-size:.95rem; color:#1e3a5f; font-weight:600; }

  /* PT TIP */
  .pt-tip { background:linear-gradient(135deg,#f0fdf4,#dcfce7); border:1.5px solid #86efac; border-radius:var(--radius-md); padding:.7rem 1rem; margin:.7rem 0; display:flex; align-items:flex-start; gap:.6rem; font-size:.88rem; color:#166534; font-weight:600; }

  /* FORMULA BOX */
  .formula { background:linear-gradient(90deg,#dbeafe,#eff6ff); border-left:4px solid var(--blue-500); border-radius:0 var(--radius-md) var(--radius-md) 0; padding:.7rem 1.1rem; font-family:'Baloo 2',cursive; font-weight:800; font-size:1.05rem; color:var(--blue-700); margin:.7rem 0; }

  /* TABLE */
  .tbl-wrap { overflow-x:auto; margin:.8rem 0; border-radius:var(--radius-md); border:1.5px solid var(--glass-border); }
  table { width:100%; border-collapse:collapse; font-size:.88rem; }
  th { background:linear-gradient(90deg,var(--blue-500),var(--blue-600)); color:#fff; font-weight:800; padding:.55rem .9rem; text-align:left; font-family:'Baloo 2',cursive; font-size:.85rem; letter-spacing:.03em; }
  td { padding:.5rem .9rem; border-bottom:1px solid rgba(191,219,254,.5); color:#1e3a5f; font-weight:600; }
  tr:last-child td { border-bottom:none; }
  tr:nth-child(even) td { background:rgba(219,234,254,.3); }
  td .tag { display:inline-block; background:var(--blue-100); color:var(--blue-700); border-radius:99px; padding:.1rem .5rem; font-size:.75rem; font-weight:700; margin-left:.3rem; }

  /* EXAMPLES */
  .examples { list-style:none; display:flex; flex-direction:column; gap:.5rem; margin:.7rem 0; }
  .examples li { background:rgba(219,234,254,0.4); border-radius:var(--radius-md); padding:.6rem 1rem; font-size:.92rem; font-weight:600; color:#1e3a5f; display:flex; align-items:flex-start; gap:.6rem; }
  .examples li::before { content:'✦'; color:var(--blue-400); font-size:.7rem; margin-top:.25rem; flex-shrink:0; }
  .ex-tr { font-size:.78rem; color:#64748b; font-weight:600; font-style:italic; margin-left:.3rem; }

  /* STEPS */
  .steps { display:grid; gap:.8rem; margin:.8rem 0; }
  .step { display:flex; gap:.9rem; align-items:flex-start; background:rgba(219,234,254,.35); border-radius:var(--radius-md); padding:.8rem 1rem; }
  .step-num { min-width:32px; height:32px; background:linear-gradient(135deg,var(--blue-400),var(--blue-600)); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Baloo 2',cursive; font-weight:800; font-size:.9rem; color:#fff; box-shadow:0 2px 8px rgba(37,99,235,.25); }
  .step-body strong { display:block; font-size:.95rem; color:var(--blue-700); font-weight:800; }
  .step-body span { font-size:.85rem; color:#334155; }
  .step-body .tip { font-size:.78rem; color:#2563eb; background:#eff6ff; border-radius:6px; padding:.2rem .5rem; margin-top:.3rem; display:inline-block; font-weight:700; }

  /* QUIZ */
  .quiz-section { margin-top:1.4rem; }
  .quiz-section h3 { font-family:'Baloo 2',cursive; font-weight:800; font-size:1rem; color:var(--blue-700); margin-bottom:.8rem; display:flex; align-items:center; gap:.4rem; }
  .quiz-q { background:rgba(239,246,255,.8); border:1.5px solid rgba(191,219,254,.7); border-radius:var(--radius-lg); padding:1rem 1.2rem; margin-bottom:.9rem; }
  .quiz-q p { font-size:.93rem; font-weight:700; color:#1e3a5f; margin-bottom:.7rem; }
  .quiz-opts { display:flex; flex-direction:column; gap:.45rem; }
  .quiz-opt { background:#fff; border:1.5px solid rgba(191,219,254,.8); border-radius:var(--radius-md); padding:.55rem .9rem; font-size:.87rem; font-weight:600; cursor:pointer; transition:all .18s; color:#1e3a5f; display:flex; align-items:center; gap:.6rem; }
  .quiz-opt:hover { border-color:var(--blue-400); background:#eff6ff; }
  .quiz-opt.correct { background:linear-gradient(90deg,#dcfce7,#f0fdf4); border-color:#22c55e; color:#166534; }
  .quiz-opt.wrong   { background:linear-gradient(90deg,#fef2f2,#fff5f5); border-color:#ef4444; color:#991b1b; }
  .quiz-opt.disabled { pointer-events:none; }
  .quiz-fb { margin-top:.6rem; font-size:.82rem; font-weight:700; padding:.4rem .8rem; border-radius:var(--radius-md); display:none; }
  .quiz-fb.show { display:block; }
  .quiz-fb.ok  { background:#dcfce7; color:#166534; }
  .quiz-fb.err { background:#fef2f2; color:#991b1b; }
  .quiz-open { background:rgba(239,246,255,.8); border:1.5px solid rgba(191,219,254,.7); border-radius:var(--radius-lg); padding:1rem 1.2rem; margin-bottom:.9rem; }
  .quiz-open p { font-size:.93rem; font-weight:700; color:#1e3a5f; margin-bottom:.5rem; }
  .open-answer { background:#fff; border:1.5px solid #bfdbfe; border-radius:var(--radius-md); padding:.6rem .9rem; font-size:.88rem; color:#166534; font-weight:700; margin-top:.4rem; display:none; cursor:pointer; }
  .btn-show { background:var(--blue-500); color:#fff; border:none; border-radius:var(--radius-md); padding:.45rem 1rem; font-size:.82rem; font-weight:800; cursor:pointer; transition:background .18s; }
  .btn-show:hover { background:var(--blue-600); }

  /* EXERCISE */
  .exercise { background:rgba(224,242,254,.5); border:1.5px solid rgba(147,197,253,.5); border-radius:var(--radius-lg); padding:1rem 1.2rem; margin-top:.9rem; }
  .exercise h4 { font-family:'Baloo 2',cursive; font-weight:800; font-size:.95rem; color:var(--blue-700); margin-bottom:.7rem; }
  .fill-q { display:flex; align-items:center; flex-wrap:wrap; gap:.35rem; margin-bottom:.6rem; font-size:.9rem; font-weight:600; color:#1e3a5f; }
  .fill-input { border:none; border-bottom:2px solid var(--blue-400); background:transparent; font-family:'Nunito',sans-serif; font-size:.9rem; font-weight:700; color:var(--blue-700); width:90px; outline:none; text-align:center; padding:.1rem .2rem; }
  .fill-input.ok  { border-color:#22c55e; color:#166534; }
  .fill-input.err { border-color:#ef4444; color:#991b1b; }
  .btn-check-all { background:linear-gradient(90deg,var(--blue-500),var(--blue-600)); color:#fff; border:none; border-radius:var(--radius-md); padding:.5rem 1.2rem; font-size:.85rem; font-weight:800; cursor:pointer; margin-top:.7rem; }
  .btn-check-all:hover { filter:brightness(1.1); }

  /* PILL TAGS */
  .pill { display:inline-block; border-radius:99px; padding:.2rem .7rem; font-size:.76rem; font-weight:800; margin:.15rem; }
  .pill-blue   { background:#dbeafe; color:#1d4ed8; }
  .pill-green  { background:#dcfce7; color:#166534; }
  .pill-purple { background:#ede9fe; color:#5b21b6; }
  .pill-orange { background:#ffedd5; color:#c2410c; }
  .pill-pink   { background:#fce7f3; color:#9d174d; }

  /* MEMORY CARD */
  .memory-box { background:linear-gradient(135deg,#fef9c3,#fef3c7); border:1.5px solid #fde68a; border-radius:var(--radius-lg); padding:1rem 1.2rem; margin:.8rem 0; display:flex; gap:.8rem; align-items:flex-start; }
  .memory-box .emoji { font-size:1.6rem; }
  .memory-box strong { display:block; font-size:.82rem; font-weight:800; color:#92400e; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.2rem; }
  .memory-box p { font-size:.88rem; color:#78350f; font-weight:600; }

  /* COMPARISON */
  .compare-grid { display:grid; grid-template-columns:1fr 1fr; gap:.8rem; margin:.8rem 0; }
  @media(max-width:500px){ .compare-grid { grid-template-columns:1fr; } }
  .compare-card { border-radius:var(--radius-md); padding:.9rem 1rem; }
  .compare-card.a { background:linear-gradient(135deg,#ede9fe,#ddd6fe); border:1.5px solid #c4b5fd; }
  .compare-card.b { background:linear-gradient(135deg,#dcfce7,#d1fae5); border:1.5px solid #86efac; }
  .compare-card strong { display:block; font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.4rem; }
  .compare-card.a strong { color:#5b21b6; }
  .compare-card.b strong { color:#166534; }
  .compare-card span { font-size:.88rem; font-weight:600; }

  /* TIMELINE */
  .timeline { display:flex; align-items:center; gap:.3rem; margin:.8rem 0; flex-wrap:wrap; }
  .tl-node { background:linear-gradient(135deg,var(--blue-400),var(--blue-600)); color:#fff; border-radius:var(--radius-md); padding:.45rem .9rem; font-size:.82rem; font-weight:800; white-space:nowrap; }
  .tl-arrow { color:var(--blue-400); font-size:1.2rem; font-weight:900; }
  .tl-label { font-size:.72rem; color:#64748b; font-weight:700; }

  /* CHARACTERS */
  .chars-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:.8rem; margin:.8rem 0; }
  .char-card { background:rgba(219,234,254,.4); border:1.5px solid rgba(191,219,254,.7); border-radius:var(--radius-lg); padding:.9rem 1rem; text-align:center; }
  .char-avatar { font-size:2rem; margin-bottom:.4rem; }
  .char-name { font-family:'Baloo 2',cursive; font-weight:800; font-size:1rem; color:var(--blue-700); }
  .char-tags { margin-top:.4rem; }

  /* SUMMARY RIBBON */
  .summary-ribbon { max-width:860px; margin:2rem auto; padding:0 1rem; position:relative; z-index:1; }
  .ribbon-card { background:linear-gradient(135deg,var(--blue-600),var(--blue-700)); border-radius:var(--radius-xl); padding:1.8rem 2rem; color:#fff; box-shadow:0 8px 32px rgba(37,99,235,.25); }
  .ribbon-card h2 { font-family:'Baloo 2',cursive; font-weight:800; font-size:1.3rem; margin-bottom:1rem; display:flex; align-items:center; gap:.5rem; }
  .ribbon-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
  .ribbon-unit { background:rgba(255,255,255,.12); border-radius:var(--radius-md); padding:.9rem 1.1rem; border:1px solid rgba(255,255,255,.2); }
  .ribbon-unit strong { display:block; font-size:.82rem; font-weight:800; opacity:.85; margin-bottom:.4rem; text-transform:uppercase; letter-spacing:.04em; }
  .ribbon-unit ul { list-style:none; display:flex; flex-direction:column; gap:.25rem; }
  .ribbon-unit li { font-size:.85rem; font-weight:600; display:flex; align-items:flex-start; gap:.4rem; opacity:.92; }
  .ribbon-unit li::before { content:'✓'; font-size:.7rem; margin-top:.18rem; opacity:.8; flex-shrink:0; }

  /* FOOTER */
  footer { text-align:center; padding:2.5rem 1rem 3rem; position:relative; z-index:1; }
  footer p { font-size:.82rem; color:#64748b; font-weight:600; }

  /* SCORE MODAL */
  .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:999; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
  .modal-overlay.show { display:flex; }
  .modal-box { background:#fff; border-radius:var(--radius-xl); padding:2.5rem; max-width:360px; width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,.2); animation:pop .3s cubic-bezier(.34,1.56,.64,1); }
  @keyframes pop { from{transform:scale(.7);opacity:0} to{transform:scale(1);opacity:1} }
  .modal-emoji { font-size:3.5rem; margin-bottom:.8rem; }
  .modal-title { font-family:'Baloo 2',cursive; font-weight:800; font-size:1.5rem; color:var(--blue-700); margin-bottom:.4rem; }
  .modal-score { font-size:2.5rem; font-weight:900; color:var(--blue-600); margin:.5rem 0; }
  .modal-msg { font-size:.95rem; color:#64748b; font-weight:600; margin-bottom:1.2rem; }
  .btn-close-modal { background:linear-gradient(90deg,var(--blue-500),var(--blue-600)); color:#fff; border:none; border-radius:99px; padding:.6rem 1.8rem; font-size:.95rem; font-weight:800; cursor:pointer; }
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="logo">
    <div class="logo-icon">📘</div>
    <div>
      <div class="logo-text">ELA · Year 5</div>
      <div class="logo-sub">Maple Bear Maceió</div>
    </div>
  </div>
  <div class="progress-bar-wrap">
    <div class="progress-label">Progresso do Quiz</div>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  </div>
  <div class="score-badge">⭐ <span id="scoreDisplay">0</span> pts</div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-badge">📚 Recuperação · Abril &amp; Maio</div>
  <h1>E.L.A — Recuperação</h1>
  <p>English Language and Arts · Year 5 · Maple Bear Maceió</p>
  <div class="hero-meta">
    <span class="meta-chip">🏫 Units 1, 2 &amp; 3</span>
    <span class="meta-chip">📖 10 Materiais</span>
    <span class="meta-chip">✏️ Quizzes Interativos</span>
    <span class="meta-chip">🏆 Pontuação</span>
  </div>
</section>

<!-- STUDY GUIDE -->
<div class="study-guide">
  <div class="guide-card">
    <h2>🗺️ Roteiro de Estudos — Como Usar Este Material</h2>
